{
  "name": "deva-workspace",
  "private": true,
  "description": "Deva - 对话式 AI 助手 · All in Chat",
  "license": "MIT",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter devaplus dev",
    "build": "pnpm --filter devaplus build",
    "start": "pnpm --filter devaplus start",
    "typecheck": "pnpm --filter devaplus typecheck",
    "package:win": "pnpm --filter devaplus build:win",
    "package:mac": "pnpm --filter devaplus build:mac",
    "package:linux": "pnpm --filter devaplus build:linux",
    "relay:login": "pnpm --filter @deva/relay exec wrangler login --device",
    "relay:deploy": "pnpm --filter devaplus build:mobile && pnpm --filter @deva/relay run deploy",
    "relay:dev": "pnpm --filter devaplus build:mobile && pnpm --filter @deva/relay run dev",
    "relay-node:build": "pnpm --filter devaplus build:mobile && pnpm --filter @deva/relay-node run build",
    "relay-node:deploy": "pnpm relay-node:build && pnpm --filter @deva/relay-node run deploy",
    "relay-node:start": "pnpm --filter @deva/relay-node run start"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "@parcel/watcher"
    ]
  }
}
