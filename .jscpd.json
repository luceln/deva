{
  "minTokens": 60,
  "minLines": 6,
  "mode": "mild",
  "format": ["typescript", "tsx"],
  "pattern": "**/*.{ts,tsx}",
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/out/**",
    "**/build/**",
    "**/tests/**",
    "**/*.d.ts",
    "**/release/**"
  ],
  "ignorePattern": [
    "(?s)/\\* jscpd:ignore-start \\*/.*?/\\* jscpd:ignore-end \\*/"
  ],
  "reporters": ["console"],
  "noColors": true,
  "noTips": true,
  "silent": true
}